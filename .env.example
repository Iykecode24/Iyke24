# ============================================================
# IYKE CONTENT STUDIO — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ============================================================

# ---- Application ----
APP_NAME=IykeContentStudio
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-64-char-string
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
CORS_ORIGINS=https://iykestudio.com,https://www.iykestudio.com

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://iyke:iyke_password@localhost:5432/iyke_studio
DATABASE_URL_SYNC=postgresql://iyke:iyke_password@localhost:5432/iyke_studio
POSTGRES_USER=iyke
POSTGRES_PASSWORD=iyke_password
POSTGRES_DB=iyke_studio

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- JWT Auth ----
JWT_SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Encryption (Fernet key for API secrets) ----
ENCRYPTION_KEY=generate-with-python-cryptography-fernet

# ---- OpenAI ----
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
# OPENAI_ENDPOINT=https://api.openai.com/v1

# ---- ElevenLabs ----
# ELEVENLABS_API_KEY=...
# ELEVENLABS_DEFAULT_VOICE_ID=pNInz6obpgDQGcFmaJgB

# ---- RunPod ----
# RUNPOD_API_KEY=...
# RUNPOD_DEFAULT_GPU=NVIDIA GeForce RTX 4090
# RUNPOD_NETWORK_VOLUME_ID=...
# RUNPOD_DATACENTER=US-EAST-1

# ---- Cloud Storage (S3-Compatible) ----
# STORAGE_PROVIDER=r2
# STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY=...
# STORAGE_SECRET_KEY=...
# STORAGE_BUCKET=iyke-studio
# STORAGE_REGION=auto
# STORAGE_PUBLIC_URL=https://media.yourdomain.com

# ---- Social Media OAuth ----
# YOUTUBE_CLIENT_ID=...
# YOUTUBE_CLIENT_SECRET=...
# FACEBOOK_APP_ID=...
# FACEBOOK_APP_SECRET=...
# INSTAGRAM_APP_ID=...
# INSTAGRAM_APP_SECRET=...
# TIKTOK_CLIENT_KEY=...
# TIKTOK_CLIENT_SECRET=...
# LINKEDIN_CLIENT_ID=...
# LINKEDIN_CLIENT_SECRET=...
# X_CLIENT_ID=...
# X_CLIENT_SECRET=...

# ---- Email (for verification & password reset) ----
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASSWORD=...
# SMTP_FROM=noreply@yourdomain.com

# ---- Cost Limits ----
DEFAULT_PROJECT_COST_LIMIT=50.00
DEFAULT_DAILY_COST_LIMIT=100.00
DEFAULT_MONTHLY_COST_LIMIT=500.00
GPU_EMERGENCY_SHUTDOWN_MINUTES=60
MAX_SIMULTANEOUS_GPU_INSTANCES=2
MAX_RENDER_RETRIES=3

# ---- Content Safety ----
CONTENT_SAFETY_ENABLED=true
REQUIRE_FACE_CONSENT=true
REQUIRE_VOICE_CONSENT=true
AI_DISCLOSURE_ENABLED=true

# ---- File Retention (days) ----
TEMP_FILE_RETENTION_DAYS=7
FAILED_RENDER_RETENTION_DAYS=30
DRAFT_RETENTION_DAYS=90
COMPLETED_PROJECT_RETENTION_DAYS=365
